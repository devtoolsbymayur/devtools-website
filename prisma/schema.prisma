// DATABASE_URL in .env / .env.local (never commit secrets)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled URL for app (Vercel/serverless) — use Supabase Transaction pooler :6543
  url       = env("DATABASE_URL")
  // Direct DB URL for prisma db push / migrate (port 5432)
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  status    String   @default("new") // new | read | replied
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

model AdSlot {
  id          String   @id @default(cuid())
  placement   String   @unique // below-header | between-tool-seo | sidebar | before-faq
  label       String
  enabled     Boolean  @default(false)
  adUnitCode  String   @default("")
  updatedAt   DateTime @updatedAt
}

model ToolConfig {
  id           String @id @default(cuid())
  toolKey      String @unique
  label        String
  href         String
  status       String @default("coming-soon") // live | coming-soon | hidden
  displayOrder Int    @default(0)
}

model SeoContent {
  id              String   @id @default(cuid())
  pageKey         String   @unique
  metaTitle       String   @default("")
  metaDescription String   @default("")
  faqItems        Json     @default("[]")
  updatedAt       DateTime @updatedAt
}

model PageViewDaily {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  path      String
  views     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([date, path])
  @@index([date])
}

/** Consent-gated anonymous visitor stats (masked IP, no passwords/PII forms). */
model SiteVisitor {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  visitorKey  String
  ipMasked    String   @default("")
  country     String   @default("")
  region      String   @default("")
  city        String   @default("")
  path        String   @default("/")
  userAgent   String   @default("")
  browser     String   @default("")
  device      String   @default("")
  language    String   @default("")
  timezone    String   @default("")
  hits        Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([date, visitorKey])
  @@index([date])
  @@index([lastSeenAt])
  @@index([country])
}
